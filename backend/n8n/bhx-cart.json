    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst items = body.items || [];\nconst fmt = (n) => Number(n).toLocaleString('vi-VN');\n\nconst have = items.filter(i => i.available);\nconst miss = items.filter(i => !i.available);\n\nconst lines = ['CÓ THỂ MUA TẠI BÁCH HOÁ XANH'];\nfor (const i of have) {\n  lines.push(`☐ ${i.ingredient}: cần ${i.quantity} ${i.unit} → ${i.packs_needed} × ${i.product_name} = ${fmt(i.subtotal_vnd)}đ`);\n}\nlines.push('', 'TỰ MUA (chưa tìm thấy trên Bách Hoá Xanh)');\nfor (const i of miss) {\n  lines.push(`☐ ${i.ingredient}: ${i.quantity} ${i.unit}`);\n}\n\nlet text = lines.join('\\n');\nif (text.length > 1900) text = text.slice(0, 1900) + '…';  // Notion giới hạn 2000 ký tự mỗi ô text\n\nreturn [{\n  json: {\n    title: `${body.dish?.name ?? 'Món'} — ${body.request_id ?? 'no-id'}`,\n    dish: body.dish?.name ?? '',\n    requestId: body.request_id ?? '',\n    available: have.length,\n    unavailable: miss.length,\n    total: body.summary?.estimated_total_vnd ?? 0,\n    itemsText: text,\n  },\n}];"
      },
